{
  "name": "ko-observer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/app/main.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "node --import tsx --test \"integration/**/*.test.ts\"",
    "test:emulator": "npx --yes firebase-tools@15.17.0 emulators:exec --config firebase.test.json --only firestore --project demo-ko-observer \"npm run test:integration\"",
    "start": "node dist/app/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "firebase-admin": "^13.4.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
